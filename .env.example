# =============================================================================
# BlackAll LLM 게이트웨이 환경변수  (사양서 §9)
# 이 파일을 .env 로 복사해서 채운다. .env 는 커밋하지 않는다.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # 마이그레이션·관리 작업 전용. 런타임에서 쓰지 않는다.

# --- DB 롤별 접속 문자열 ------------------------------------------------------
# 사양서 §2-1 의 격리는 "롤이 다르다"로 성립한다. 아래 셋을 절대 섞어 쓰지 않는다.
#
#   ADMIN_DATABASE_URL     소유자 롤. 마이그레이션·키 발급·라이선스 승격에만.
#   GATEWAY_DATABASE_URL   gateway_writer. 게이트웨이 런타임 전용.
#   TRAINING_DATABASE_URL  training_pipeline. 학습 파이프라인 전용.
#                          이 롤은 reference 스키마에 접근할 수 없다.
#                          ★ 학습 파이프라인에 service_role 키를 주면 격리가 무효가 된다.
#   ANALYTICS_DATABASE_URL analytics_reader. 대시보드 전용.
#
# 비밀번호는 scripts/set-role-passwords.sql 로 설정한다.
ADMIN_DATABASE_URL=
GATEWAY_DATABASE_URL=
TRAINING_DATABASE_URL=
ANALYTICS_DATABASE_URL=

# 사양서 §9 의 SUPABASE_TRAINING_ROLE_KEY 에 해당한다.
# PostgREST 키가 아니라 위의 TRAINING_DATABASE_URL 이 실제 격리 수단이다.

# --- 추론 제공자 --------------------------------------------------------------
# 오픈모델 1차: Groq (사양서 §3)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPEN_MODEL_ID=open/gpt-oss-20b

# 외부 고성능 폴백 (§5-2). OpenAI 호환 엔드포인트면 무엇이든 된다.
# 이 계층의 출력은 영구적으로 학습 불가다 — reference 스키마로만 간다.
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_MODEL=
EXTERNAL_MODEL_ID=external/frontier

# 자체 모델 (4~6개월차). 비워두면 자체 계층은 비활성이고, 승격된 유형도 오픈모델로 간다.
SELF_MODEL_BASE_URL=
SELF_MODEL_API_KEY=
SELF_MODEL_ID=

# --- 학습 (4~6개월차) ---------------------------------------------------------
TOGETHER_API_KEY=
HF_TOKEN=

# --- 대용량 보관 (Cloudflare R2) ---------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- 라우팅 상한 (사양서 §9, §5-3) --------------------------------------------
# 실제 진실은 training.gateway_config 다. 아래 값은 DB 설정을 "조일" 수만 있다.
#   SELF_MODEL_MAX_RATIO 는 더 낮은 쪽이 이기고,
#   EXPLORE_RATIO 는 더 높은 쪽이 이긴다.
SELF_MODEL_MAX_RATIO=0.75
EXPLORE_RATIO=0.05
